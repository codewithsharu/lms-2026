# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=y
SUPABASE_DB_URL=

# Startup Schema Sync (recommended true for server environments)
AUTO_SCHEMA_SYNC_ON_START=true
# Optional: override default schema file path
# SCHEMA_SQL_PATH=database/schema.sql
# Optional: override required table list (comma separated)
# REQUIRED_SCHEMA_TABLES=users,classes,sections,student_details,teacher_details,teacher_assignments,audit_logs,assessment_templates,hosted_assessments

# Server Configuration
PORT=5000
FRONTEND_URLS=http://localhost:5173,https://lms-2026-pi.vercel.app
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
# Optional: set only if you need cookie scoped to a parent domain
# COOKIE_DOMAIN=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=
